/E (  Serial.println\("Remove finger"\);   delay\(2000\);   p = 0;   while \(p != FINGERPRINT_NOFINGER\)    {     p = finger.getImage\(\);   }   Serial.print\("ID "\); Serial.println\(id\);   p = -1;   Serial.println\("Place same finger again"\);   while \(p != FINGERPRINT_OK\)    {     p = finger.getImage\(\);     switch \(p\)      {     case FINGERPRINT_OK:       Serial.println\("Image taken"\);       break;     case FINGERPRINT_NOFINGER:       break;     case FINGERPRINT_PACKETRECIEVEERR:       Serial.println\("Communication error"\);       break;     case FINGERPRINT_IMAGEFAIL:       Serial.println\("Imaging error"\);       break;     default:       Serial.println\("Unknown error"\);       break;     }   })
